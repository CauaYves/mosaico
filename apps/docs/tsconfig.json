{
  "extends": "@multiclubes/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/registry/mosaico/components/mosaico/*": ["../../packages/ui/src/components/*"],
      "@/registry/mosaico/hooks/mosaico/*": ["../../packages/ui/src/hooks/*"],
      "@/registry/mosaico/lib/mosaico/*": ["../../packages/ui/src/lib/*"],
      "@/*": ["./*"]
    },
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", "next.config.js", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".shadcn-upstream", "content"]
}
